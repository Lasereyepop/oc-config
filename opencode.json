{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/build.txt}",
      "tools": {
        "bash": true,
        "edit": true,
        "write": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "instructions": [
    "issues/*.md"
  ],
  "mcp": {
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "skills": {
    "paths": [
      "~/.config/opencode/.agents/skills"
    ]
  }
}