{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["issues/*.md"],
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "prompt": "{file:./prompts/build.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "{file:./prompts/plan.txt}",
      "permission": {
        "task": {
          "*": "deny",
          "reviewer": "allow"
        }
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}
